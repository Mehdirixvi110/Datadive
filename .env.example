# Datadive — environment variables (design §20)
#
# EVERY variable below is OPTIONAL for `npm run build`, `npm run lint`, and the
# public site render. With ZERO variables set, the site builds and renders fully
# from seed data; a missing value only disables the one privileged feature it
# powers. Never commit real secrets — this file holds placeholders only.

# --- Airtable (live content) -------------------------------------------------
# Only these two are mandatory to serve LIVE content. Absent → seed data served.
AIRTABLE_API_KEY=pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Optional table-name overrides. Table names default in code (src/lib/airtable/
# schema.ts); set these ONLY if you renamed tables in Airtable.
# AIRTABLE_TABLE_SETTINGS=Settings
# AIRTABLE_TABLE_HERO=Hero
# AIRTABLE_TABLE_ABOUT=About
# AIRTABLE_TABLE_SERVICES=Services
# AIRTABLE_TABLE_PROJECTS=Projects
# AIRTABLE_TABLE_PROJECTIMAGES=ProjectImages
# AIRTABLE_TABLE_INDUSTRIES=Industries
# AIRTABLE_TABLE_STATS=Stats
# AIRTABLE_TABLE_CLIENTS=Clients
# AIRTABLE_TABLE_REVIEWS=Reviews
# AIRTABLE_TABLE_TEAMMEMBERS=TeamMembers
# AIRTABLE_TABLE_BLOGPOSTS=BlogPosts
# AIRTABLE_TABLE_CTABAND=CtaBand
# AIRTABLE_TABLE_NAVLINKS=NavLinks
# AIRTABLE_TABLE_CONTACTSUBMISSIONS=ContactSubmissions

# --- Auth (admin dashboard, NextAuth v5 / Google) ----------------------------
# Absent → admin login is disabled; the public site is unaffected.
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_GOOGLE_ID=xxxxxxxxxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated allowlist of admin emails. Absent/empty → no one is admin.
ADMIN_EMAILS=admin@example.com

# --- Vercel Blob (image upload) ----------------------------------------------
# Absent → upload disabled; paste-URL + seed images still work.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Site metadata -----------------------------------------------------------
# Absolute base for metadata/OG/sitemap. Absent → falls back to VERCEL_URL then
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.datadiveanalytics.com

# --- Optional external revalidate route --------------------------------------
# Absent → the secret-gated /api/revalidate route is disabled (in-process
# revalidation after admin edits still works).
REVALIDATE_SECRET=some_long_random_shared_secret

# --- Contact email notification (optional) -----------------------------------
# Absent → submissions are still saved to Airtable; no email is sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_NOTIFY_TO=leads@example.com
